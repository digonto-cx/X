{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/task/:id",
      "destination": "/task-details.html?id=:id"
    },
    {
      "source": "/admin/user",
      "destination": "/admin/users.html"
    },
    {
      "source": "/admin/task",
      "destination": "/admin/tasks.html"
    },
    {
      "source": "/admin/submit",
      "destination": "/admin/submissions.html"
    },
    {
      "source": "/admin/withdraw",
      "destination": "/admin/withdraw.html"
    },
    {
      "source": "/admin/imgbb",
      "destination": "/admin/imgbb.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/tasks",
      "destination": "/tasks.html"
    },
    {
      "source": "/withdraw",
      "destination": "/withdraw.html"
    },
    {
      "source": "/games",
      "destination": "/games.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
