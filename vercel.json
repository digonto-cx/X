{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/public/landing.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/admin/user",
      "destination": "/public/admin/users.html"
    },
    {
      "source": "/admin/task",
      "destination": "/public/admin/tasks.html"
    },
    {
      "source": "/admin/submit",
      "destination": "/public/admin/submissions.html"
    },
    {
      "source": "/admin/withdraw",
      "destination": "/public/admin/withdraw.html"
    },
    {
      "source": "/admin/imgbb",
      "destination": "/public/admin/imgbb.html"
    },
    {
      "source": "/tasks",
      "destination": "/public/tasks.html"
    },
    {
      "source": "/task/:id",
      "destination": "/public/task-details.html?id=:id"
    },
    {
      "source": "/withdraw",
      "destination": "/public/withdraw.html"
    },
    {
      "source": "/games",
      "destination": "/public/games.html"
    },
    {
      "source": "/login",
      "destination": "/public/login.html"
    },
    {
      "source": "/register",
      "destination": "/public/register.html"
    },
    {
      "source": "/assets/:match*",
      "destination": "/public/assets/:match*"
    }
  ]
}
