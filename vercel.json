{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "/public/admin/index.html"
    },
    {
      "src": "/tasks",
      "dest": "/public/tasks.html"
    },
    {
      "src": "/task/(.*)",
      "dest": "/public/task-details.html?id=$1"
    },
    {
      "src": "/withdraw",
      "dest": "/public/withdraw.html"
    },
    {
      "src": "/games",
      "dest": "/public/games.html"
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/register",
      "dest": "/public/register.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
